{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-stack.invalid/schemas/research-record.schema.json",
  "title": "Research Stack normalized literature record",
  "type": "object",
  "required": ["id", "doi", "sourceIds", "attribution", "title", "authors", "year", "date", "venue", "publicationType", "abstract", "url", "openAccessUrl", "license", "evidenceScope", "access", "review", "warnings"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "doi": {"$ref": "#/$defs/provenanceField", "properties": {"value": {"type": ["string", "null"], "pattern": "^10\\.\\d{4,9}/\\S+$"}}, "required": ["value", "provenance"]},
    "sourceIds": {"type": "object", "additionalProperties": {"type": "string"}},
    "attribution": {"type": "array", "items": {"type": "object", "required": ["provider", "url", "publicDisplayRequiresNameAndLogo"], "properties": {"provider": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "publicDisplayRequiresNameAndLogo": {"type": "boolean"}}, "additionalProperties": false}},
    "title": {"$ref": "#/$defs/provenanceField"},
    "authors": {"$ref": "#/$defs/provenanceField"},
    "year": {"$ref": "#/$defs/provenanceField"},
    "date": {"$ref": "#/$defs/provenanceField"},
    "venue": {"$ref": "#/$defs/provenanceField"},
    "publicationType": {"$ref": "#/$defs/provenanceField"},
    "abstract": {"$ref": "#/$defs/provenanceField"},
    "url": {"$ref": "#/$defs/provenanceField"},
    "openAccessUrl": {"$ref": "#/$defs/provenanceField"},
    "license": {"$ref": "#/$defs/provenanceField"},
    "evidenceScope": {"enum": ["metadata-only", "abstract-only", "full-text", "extraction-incomplete"]},
    "access": {"type": "object", "required": ["status", "url", "license", "retrieved"], "properties": {"status": {"enum": ["unknown", "link-reported", "license-verified", "retrieved", "denied"]}, "url": {"type": ["string", "null"]}, "license": {"type": ["string", "null"]}, "retrieved": {"type": "boolean"}}, "additionalProperties": true},
    "review": {"type": "object", "required": ["status", "notes"], "properties": {"status": {"type": "string"}, "notes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "provenanceField": {
      "type": "object",
      "required": ["value", "provenance"],
      "properties": {
        "value": {},
        "provenance": {"oneOf": [{"$ref": "#/$defs/source"}, {"type": "array", "items": {"$ref": "#/$defs/source"}}]},
        "conflicts": {"type": "array"}
      },
      "additionalProperties": true
    },
    "source": {"type": "object", "required": ["provider", "upstreamId", "fetchedAt", "queryHash"], "properties": {"provider": {"type": "string"}, "upstreamId": {"type": "string"}, "fetchedAt": {"type": "string", "format": "date-time"}, "queryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
