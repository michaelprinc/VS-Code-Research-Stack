  "installSteps": [
    {
      "id": "worker",
      "label": "Isolated locked worker (Python 3.12)",
      "description": "Copies the reviewed worker source and lock into .research-toolkit/managed/worker-<version>, syncs it with uv and verifies real MCP reading, reports, local search and RIS preparation.",
      "packages": [
        "basic",
        "recommended",
        "full"
      ],
      "optional": false,
      "downloads": true,
      "requires": [
        "uv on PATH or researchStack.uvPath"
      ],
      "components": [
        "python",
        "mcp-python-sdk",
        "pypdf",
        "python-docx",
        "document-worker",
        "research-stack-full-markdown-bm25-prototype",
        "mcp-config"
      ],
      "prerequisites": [],
      "hostTools": [
        "uv"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "research-overlay",
      "label": "Research overlay files",
      "description": "Adds the reviewed research/ notes, five research skills and the recommended profile file. Existing workspace files are never overwritten.",
      "packages": [
        "recommended",
        "full"
      ],
      "optional": false,
      "downloads": false,
      "requires": [],
      "components": [
        "research-stack-recommended-adapter"
      ],
      "prerequisites": [],
      "hostTools": [],
      "timeoutSeconds": 60
    },
    {
      "id": "notebook-env",
      "label": "Notebook analysis environment",
      "description": "Creates notebooks/analysis with a locked Python 3.12 environment (ipykernel, matplotlib). This step downloads packages and is optional.",
      "packages": [
        "recommended",
        "full"
      ],
      "optional": true,
      "downloads": true,
      "requires": [
        "uv on PATH or researchStack.uvPath",
        "worker step"
      ],
      "components": [
        "research-analysis-python-environment"
      ],
      "prerequisites": [
        "worker"
      ],
      "hostTools": [
        "uv"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "lab-store",
      "label": "Corpus index and record store",
      "description": "Initialises .research-toolkit/store/research.sqlite3 with the reviewed schema for the corpus index, claims and evidence links. No third-party database is installed.",
      "packages": [
        "full"
      ],
      "optional": false,
      "downloads": false,
      "requires": [
        "worker step"
      ],
      "components": [
        "research-corpus-index",
        "research-record-store"
      ],
      "prerequisites": [
        "worker"
      ],
      "hostTools": [],
      "timeoutSeconds": 120
    }
  ],
  "packages": {
    "basic": {
      "label": "Basic",
      "steps": [
        "worker"
      ],
      "gate": "G1 not passed",
      "support": "prototype"
    },
    "recommended": {
      "label": "Recommended Research",
      "steps": [
        "worker",
        "research-overlay",
        "notebook-env"
      ],
      "gate": "G2 not passed",
      "support": "prototype"
    },
    "full": {
      "label": "Full",
      "steps": [
        "worker",
        "research-overlay",
        "notebook-env",
        "lab-store"
      ],
      "gate": "G3 not passed",
      "support": "prototype foundation"
    }
  }
}
