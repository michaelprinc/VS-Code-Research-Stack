{
  "name": "research-stack-toolkit",
  "displayName": "Research Stack Toolkit (Phase 4 Preview)",
  "description": "A VS Code preview for switching between Research Stack package preferences.",
  "version": "0.2.0",
  "publisher": "michaelprinc",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelprinc/VS-Code-Research-Stack.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": ["Other", "Education"],
  "extensionKind": ["ui"],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:researchToolkit.showPhaseReadiness",
    "onCommand:researchToolkit.switchPackage"
  ],
  "contributes": {
    "configuration": {
      "title": "Research Stack",
      "properties": {
        "researchStack.selectedPackage": {
          "type": "string",
          "enum": ["basic", "recommended", "full"],
          "enumItemLabels": ["Basic", "Recommended Research", "Full"],
          "default": "recommended",
          "scope": "application",
          "description": "Selected Research Stack package preference. This does not install or configure components."
        }
      }
    },
    "commands": [
      {
        "command": "researchToolkit.showPhaseReadiness",
        "title": "Research Toolkit: Show Phase Readiness",
        "category": "Research Toolkit"
      },
      {
        "command": "researchToolkit.switchPackage",
        "title": "Research Toolkit: Switch Package",
        "category": "Research Toolkit"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": { "supported": true }
  },
  "files": ["extension.js", "README.md", "package.json"],
  "license": "UNLICENSED"
}
