    "verify-package": "node scripts/with-artifact.js uv run --locked python ../scripts/verify_vsix.py",
    "check:payload": "node scripts/with-artifact.js node scripts/check-installed-payload.js",
    "test:browser": "node test/browser.test.js"
  },
