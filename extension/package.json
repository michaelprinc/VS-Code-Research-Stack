{
  "name": "research-stack-toolkit",
  "displayName": "Research Stack Toolkit (Phase 4 Preview)",
  "description": "Set up package components, verify real MCP reading and research tools, and keep components updated.",
  "version": "0.3.15",
  "publisher": "michaelprinc",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelprinc/VS-Code-Research-Stack.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "keywords": [
    "research",
    "literature review",
    "citation",
    "evidence",
    "document indexing",
    "theology",
    "notebooks",
    "MCP",
    "study notes"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:researchToolkit.showPhaseReadiness",
    "onCommand:researchToolkit.switchPackage",
    "onStartupFinished",
    "onView:researchToolkit.overview"
  ],
  "contributes": {
    "configuration": {
      "title": "Research Stack",
      "properties": {
        "researchStack.selectedPackage": {
          "type": "string",
          "enum": [
            "basic",
            "recommended",
            "full"
          ],
          "enumItemLabels": [
            "Basic",
            "Recommended Research",
            "Full"
          ],
          "default": "recommended",
          "scope": "application",
          "description": "Selected Research Stack package. It decides which component steps setup offers and which tools presets are available; nothing is installed silently."
        },
        "researchStack.toolsPreset": {
          "type": "string",
          "enum": [
            "package-default",
            "read-and-cite",
            "find-in-notes",
            "verify-citations",
            "zotero-handoff",
            "research-core",
            "research-workflow",
            "research-lab",
            "research-lab-max",
            "corpus-lab",
            "research-max-github-full",
            "research-max-github-limited",
            "research-max-no-github"
          ],
          "enumItemLabels": [
            "Follow the package default",
            "Read and cite a document",
            "Search my own notes",
            "Verify a citation",
            "Prepare a Zotero import",
            "Read, search, cite and write",
            "Full research workflow (index, evidence, claims)",
            "Documents + third-party evidence (retired)",
            "Maximum research lab (retired)",
            "Index, search and record claims",
            "Maximum research: GitHub full plus the whole store",
            "Maximum research: GitHub as read-only evidence",
            "Maximum research: the whole local store, no GitHub"
          ],
          "default": "package-default",
          "scope": "application-overridable",
          "description": "Which tools your assistant is offered, chosen by the goal you are working on rather than by MCP server. 'package-default' follows the preset recommended for the selected package. Set it in your user profile or override it per workspace folder. Nothing is installed or removed. A preset retired in a later release keeps its id and its label in this list on purpose, so a preference you saved then still resolves instead of falling back in silence; the Toolkit's panel and preset picker name the presets that replace it and refuse a new choice of a retired one."
        },
        "researchStack.showStatusBar": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show a status-bar shortcut with your saved package preference."
        },
        "researchStack.openControlPanelOnStartup": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Open the Research Toolkit control panel when VS Code starts."
        },
        "researchStack.uvPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to the uv executable to use, when it is not on the editor process PATH. Leave empty to use PATH and the documented install locations."
        },
        "researchStack.setupTimeoutSeconds": {
          "type": "number",
          "default": 900,
          "minimum": 60,
          "maximum": 3600,
          "scope": "application",
          "description": "How long a component step may run before it is reported as timed out. The first run can download a managed Python 3.12 and the locked packages."
        },
        "researchStack.integrationTimeoutMs": {
          "type": "number",
          "default": 80000,
          "minimum": 40000,
          "maximum": 300000,
          "scope": "application",
          "description": "How long one integration check (Zotero and Semantic Scholar readiness) may run before the Toolkit stops its own worker and reports the check as timed out. The default 80000 ms sits above the worker's worst case — 34 s for the three Zotero stages and the one retry of the listing that a still-loading library makes, plus 35 s for the hosted side — so a slow Zotero is reported instead of being cut off mid-check. The bound covers the whole check, not one request: at the minimum 40000 ms a Zotero-only check still gets its full worst case, while a check that asks both services may have its slower half cut off. It cannot make a service answer, cannot raise the worker's own per-request limits (5 s and 12 s for Zotero, 15 s for a provider request), and does not apply to component setup — that is researchStack.setupTimeoutSeconds."
        },
        "researchStack.integrationCooldownSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 300,
          "scope": "application",
          "description": "How long every window of this VS Code profile waits after one integration check before \"Check now\" will start another one. The window belongs to the profile record, not to a window, so several open windows cannot re-ask the same services at once, and the countdown on the card and the refusal an operator gets are the same number. 10 seconds is the shipped default: long enough that a double press or a second window does not hammer a live service, short enough that the deliberate \"I have installed Zotero — check it now\" is not refused. Below 5 seconds the window no longer separates a double press from a deliberate re-check; above 300 seconds the card would name a countdown longer than a person can wait through. Fractional seconds are used as whole seconds. It cannot make a check finish sooner, does not change the worker's own pacing floor of one request per second, and does not apply to the daily version check — that has its own window."
        },
        "researchStack.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Ask the VS Code Marketplace once a day whether a newer Research Stack Toolkit is published. The request carries only the publisher and extension name already in the public manifest — no workspace, file or user information. Turn it off to make the Toolkit contact no online service at all; component setup and every other control work the same way without it."
        }
      }
    },
