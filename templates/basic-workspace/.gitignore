# Local runtime state and generated caches
.research-toolkit/worker/.venv/
**/.venv/
.research-toolkit/worker/__pycache__/
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# Research originals are private by default; explicitly unignore selected files if desired.
papers/*
!papers/.gitkeep

# NotebookLM handoff bundles may contain source text.
notebooklm-export/

# Derived research data. The corpus index and record store hold copied source text, claim
# statements and evidence links; backups are copies of the same data. None of it is shareable
# just because the workspace is a repository.
.research-toolkit/store/
.research-toolkit/backups/
.research-toolkit/lab-state.json
.research-toolkit/managed/.setup.lock

# Setup status and attempt logs record which component steps ran, which host tools were
# used and what failed. They name workspace paths, so they stay local too.
.research-toolkit/logs/
